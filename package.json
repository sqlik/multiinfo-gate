{
  "name": "multiinfo-gate",
  "license": "MIT",
  "author": "Tomasz Sawko",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && rm -rf dist/store/migrations dist/admin/public && cp -R src/store/migrations dist/store/migrations && cp -R src/admin/public dist/admin/public",
    "start": "node dist/index.js",
    "admin:dodaj": "node dist/cli/admin.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:tekst": "sh scripts/check-tekst.sh",
    "check:dane": "sh scripts/check-dane.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "^2.1.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.1",
    "node-forge": "^1.4.0",
    "otplib": "^12.0.1",
    "qrcode-generator": "2.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/node-forge": "^1.3.14",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
